/* Phosphor-green CRT palette.
 * Hardcoded hex, mirroring boozer/theme.py (Textual .tcss files don't
 * support Python-side interpolation, so the two are kept in sync by
 * hand — see the note at the top of theme.py). */

Screen {
    background: #020402;
    color: #2ecc71;
}

Footer {
    background: #020402;
}
Footer > .footer-key--key {
    color: #ffb000;
    text-style: bold;
}
Footer > .footer-key--description {
    color: #1a7a3c;
}

#main-row {
    height: 1fr;
}

#app-header {
    height: 2;
    width: 100%;
    content-align: center middle;
    text-align: center;
    color: #39ff6a;
    text-style: bold;
    background: #020402;
}

#left-col {
    width: 1fr;
}
#right-col {
    width: 1fr;
}

#search-box {
    width: 100%;
    height: 3;
    border: round #2ecc71;
    padding: 0 1;
    margin-bottom: 1;
}
#search-box Input {
    width: 1fr;
    height: 1;
    min-height: 1;
    border: none;
    padding: 0;
    margin: 0;
    background: #020402;
    color: #39ff6a;
}
#search-box Input:focus {
    border: none;
}
#search-box Input > .input--placeholder {
    color: #1a7a3c;
}

#list-box {
    border: round #2ecc71;
    height: 1fr;
    width: 100%;
}
#list-box ListView {
    background: #020402;
    border: none;
    height: 1fr;
}
#list-box ListItem {
    padding: 0 1;
    background: #020402;
}
#list-box ListItem.row-odd {
    background: #071c0a;
}
#list-box ListView > ListItem.-highlight {
    background: #39ff6a;
    color: #02150a;
    text-style: bold;
}
#list-box ListView:focus > ListItem.-highlight {
    background: #39ff6a;
    color: #02150a;
}

#weight {
    border: round #2ecc71;
    border-title-color: #39ff6a;
    border-title-style: bold;
    height: auto;
    width: 100%;
    padding: 0 1;
    margin-top: 1;
}

#detail {
    border: round #2ecc71;
    padding: 1 2;
    height: 1fr;
    overflow-y: auto;
    border-title-color: #39ff6a;
    border-title-style: bold;
}

#examples {
    border: round #2ecc71;
    padding: 1 2;
    height: auto;
    max-height: 40%;
    margin-top: 1;
    display: none;
    border-title-color: #39ff6a;
    border-title-style: bold;
}
#examples.visible {
    display: block;
}
